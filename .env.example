# ═══════════════════════════════════════════════════════════════
#  Animus Studio — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Runtime Identity ────────────────────────────────────────────
STUDIO_NAME=Animus Studio
STUDIO_VERSION=0.1.0
INSTANCE_ID=local-dev
APP_ENV=development
SECRET_KEY=change-this-to-a-random-32-char-hex-string
JWT_SECRET=change-this-too

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# ── Mission Defaults ────────────────────────────────────────────
DEFAULT_LANGUAGE=en
DEFAULT_BRAND=AnimusLab
DEFAULT_AUDIENCE=Software Engineers
DEFAULT_TONE=Professional

# ── Worker Configuration ────────────────────────────────────────
WORKER_TIMEOUT=600
WORKER_MAX_RETRIES=3
WORKER_CONCURRENCY=2

# ── Database & Redis ────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=animus
POSTGRES_USER=animus
POSTGRES_PASSWORD=animuspass
DATABASE_URL=postgresql+asyncpg://animus:animuspass@postgres:5432/animus
REDIS_URL=redis://redis:6379

# ── Feature Flags ───────────────────────────────────────────────
ENABLE_LOCAL_MODELS=true
ENABLE_CLOUD_MODELS=false      # set true to allow cloud LLMs to win over local
ENABLE_HUMAN_APPROVAL=true
ENABLE_MEMORY=true
ENABLE_SANDBOX=false
ENABLE_EVENT_REPLAY=true
ENABLE_MISSION_TIMELINE=true
ENABLE_PROVIDER_HEALTHCHECK=true
ENABLE_RUNTIME_DOCTOR=true

# ═══════════════════════════════════════════════════════════════
#  LOCAL MODELS (primary — no cost, no key required)
# ═══════════════════════════════════════════════════════════════
OLLAMA_HOST=http://ollama:11434

DEFAULT_MODEL=qwen3:8b            # general chat / instruction
REASONING_MODEL=deepseek-r1:8b    # planning, analysis, research synthesis
FAST_MODEL=qwen2.5:3b             # quick tasks
VISION_MODEL=llava                # image understanding
EMBEDDING_MODEL=nomic-embed-text  # vector embeddings (used by memory engine)

# ── Voice (local, free) ─────────────────────────────────────────
# VOICE_PROVIDER=auto (Kokoro -> Piper -> ElevenLabs) or kokoro | piper | elevenlabs
VOICE_PROVIDER=auto
KOKORO_VOICE=af_heart
PIPER_MODEL=en_US-lessac-medium

# ── Speech-to-Text (local, free) ────────────────────────────────
WHISPER_MODEL=small

# ── Image / Thumbnail ───────────────────────────────────────────
COMFYUI_URL=

# ── Browser / Scraping ──────────────────────────────────────────
PLAYWRIGHT_BROWSER=chromium
SCRAPER_RPM=30

# ── Search ──────────────────────────────────────────────────────
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ── Scraping ────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ═══════════════════════════════════════════════════════════════
#  CLOUD PROVIDERS (optional — set ENABLE_CLOUD_MODELS=true)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ═══════════════════════════════════════════════════════════════
#  PUBLISHING
# ═══════════════════════════════════════════════════════════════
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

GITHUB_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ═══════════════════════════════════════════════════════════════
#  MEMORY & ANALYTICS
# ═══════════════════════════════════════════════════════════════
MEMORY_RETENTION_DAYS=365
MEMORY_TOP_K=10
MEMORY_MIN_SIMILARITY=0.82
YOUTUBE_ANALYTICS=true
GOOGLE_ANALYTICS_ID=

# ── Runtime Bounds & Storage ───────────────────────────────────
MAX_UPLOAD_SIZE_MB=2048
TEMP_DIRECTORY=./tmp
CACHE_DIRECTORY=./cache
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
